config BR2_PACKAGE_PRISM_LLAMA_CPP
	bool "prism-llama-cpp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_9
	depends on !BR2_TOOLCHAIN_USES_UCLIBC || !BR2_STATIC_LIBS
	depends on BR2_USE_WCHAR
	select BR2_PACKAGE_LIBEXECINFO if BR2_TOOLCHAIN_USES_UCLIBC
	help
	  PrismML llama.cpp with Bonsai quantization support and CLI tools.

	  https://github.com/PrismML-Eng/llama.cpp

comment "prism-llama-cpp needs C++, wchar, threads, and gcc >= 9"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS || !BR2_TOOLCHAIN_GCC_AT_LEAST_9

comment "prism-llama-cpp needs dynamic libraries with uClibc"
	depends on BR2_TOOLCHAIN_USES_UCLIBC && BR2_STATIC_LIBS
