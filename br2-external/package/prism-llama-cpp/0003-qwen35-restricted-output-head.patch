 #include "llama-impl.h"
 #include "llama-memory-recurrent.h"
 #include "llama-kv-cache.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+
+// CPU-only restricted PTQ1_0 head. Reuse the normal GEMV's quantizer and dot
+// kernel without copying, reordering, or dequantizing the tied embedding rows.
+static void qwen35_output_keep(
+        ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const auto & ids = *static_cast<const std::vector<int32_t> *>(userdata);
+    const ggml_tensor * weights = dst->src[0];
+    const ggml_tensor * hidden  = dst->src[1];
+    const auto * traits = ggml_get_type_traits_cpu(weights->type);
+    const size_t first = ids.size() * ith / nth;
+    const size_t last  = ids.size() * (ith + 1) / nth;
+    if (first == last) {
+        return;
+    }
+    // Partition by kept rows, but assign each worker its surrounding dropped
+    // rows too. Fill and scatter then touch disjoint spans without a barrier.
+    const int64_t begin = first == 0 ? 0 : ids[first];
+    const int64_t end   = last == ids.size() ? weights->ne[1] : ids[last];
+    for (int64_t col = 0; col < hidden->ne[1]; ++col) {
+        float * logits = reinterpret_cast<float *>(
+                static_cast<char *>(dst->data) + col * dst->nb[1]);
+        std::fill(logits + begin, logits + end, -INFINITY);
+        const char * activation = static_cast<const char *>(hidden->data) + col * hidden->nb[1];
+        for (size_t row = first; row < last; ++row) {
+            const int32_t id = ids[row];
+            const char * weight = static_cast<const char *>(weights->data) + id * weights->nb[1];
+            traits->vec_dot(weights->ne[0], logits + id, 0, weight, 0, activation, 0, 1);
+        }
+    }
+}
 
