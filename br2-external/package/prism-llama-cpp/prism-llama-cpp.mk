PRISM_LLAMA_CPP_VERSION = 5628c7338963b00a598f2a588fd09a79af6d70db
PRISM_LLAMA_CPP_SITE = $(call github,PrismML-Eng,llama.cpp,$(PRISM_LLAMA_CPP_VERSION))
PRISM_LLAMA_CPP_LICENSE = MIT
PRISM_LLAMA_CPP_LICENSE_FILES = LICENSE
PRISM_LLAMA_CPP_INSTALL_STAGING = YES
# This pin gates llama-cli behind SERVER; post-build removes llama-server.
# Disable both local and prebuilt web UI assets for offline appliance builds.
PRISM_LLAMA_CPP_CONF_OPTS = \
	-DGGML_NATIVE=OFF -DGGML_CPU_ARM_ARCH=armv8-a -DGGML_OPENMP=ON \
	-DGGML_BACKEND_DL=OFF -DGGML_CPU_ALL_VARIANTS=OFF -DBUILD_SHARED_LIBS=ON \
	-DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON \
	-DLLAMA_BUILD_TOOLS=ON -DLLAMA_BUILD_APP=OFF -DLLAMA_OPENSSL=OFF \
	-DLLAMA_BUILD_UI=OFF -DLLAMA_USE_PREBUILT_UI=OFF -DLLAMA_FATAL_WARNINGS=OFF

$(eval $(cmake-package))
