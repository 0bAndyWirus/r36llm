# Keep the BSP's hardware support; make boot/media/network essentials built in.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXFAT_FS=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_SMSC95XX=y
# Preserve both joypad implementations and GPIO LEDs seen in vendor modules.builtin.
CONFIG_JOYSTICK_ODROIDGO2=y
CONFIG_LEDS_GPIO=y
CONFIG_MII=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_BTRFS_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Generic ARM64 QEMU virt support alongside the Rockchip platform.
CONFIG_ARCH_VEXPRESS=y
CONFIG_ARM_AMBA=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM_VIRTIO=y
