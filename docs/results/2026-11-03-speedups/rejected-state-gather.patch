+        ssm_states_all->type == GGML_TYPE_F32 && ggml_is_contiguous(ssm_states_all);
+    const bool gdn_state_rows = gdn_state_rows_env && gdn_state_rows_dev_ok &&
+        (cparams.n_rs_seq > 0 || single_cpu_row) && !gdn_rpl;
 
     ggml_tensor * state;
     if (gdn_rpl) {
